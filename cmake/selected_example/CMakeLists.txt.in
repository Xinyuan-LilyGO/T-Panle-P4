set(EXAMPLE_SRCS "")
set(EXAMPLE_INCLUDE_DIRS ".")
set(EXAMPLE_REQUIRES "")
set(EXAMPLE_EMBED_FILES "")
set(T_PANEL_P4_BOARD "@T_PANEL_P4_BOARD@")

include("@T_PANEL_P4_EXAMPLE_CMAKE@")

if(NOT EXAMPLE_SRCS)
    message(FATAL_ERROR "Selected example did not define EXAMPLE_SRCS")
endif()

set(COMPONENT_ARGS
    SRCS ${EXAMPLE_SRCS}
    INCLUDE_DIRS ${EXAMPLE_INCLUDE_DIRS}
)
if(EXAMPLE_REQUIRES)
    list(APPEND COMPONENT_ARGS REQUIRES ${EXAMPLE_REQUIRES})
endif()
if(EXAMPLE_EMBED_FILES)
    list(APPEND COMPONENT_ARGS EMBED_FILES ${EXAMPLE_EMBED_FILES})
endif()

idf_component_register(${COMPONENT_ARGS})
