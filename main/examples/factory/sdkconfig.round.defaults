# The round Home carousel is rendered into a complete back buffer and swapped
# at frame boundaries so the DPI engine never scans a partially updated frame.
CONFIG_DISPLAY_PANEL_RGB888=y
CONFIG_DISPLAY_PANEL_FRAME_BUFFER_COUNT=2
# CONFIG_LV_COLOR_DEPTH_16 is not set
CONFIG_LV_COLOR_DEPTH_24=y 

# Run the LVGL task and animations close to the panel's 59 Hz refresh rate.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DEF_REFR_PERIOD=16

# Offload compatible RGB888 image composition (including camera preview) to PPA.
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
CONFIG_LV_PPA_BURST_LENGTH=64

# The Home cards use a 34 px shadow plus a 20 px corner radius.
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=64
